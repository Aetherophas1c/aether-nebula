{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Aetherophas1c/aether-nebula/blob/main/mod-store/schema/submission.schema.json",
  "title": "Aether Nebula Mod Store Submission Entry",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "author",
    "description",
    "category",
    "platforms",
    "permissions",
    "min_nebula_version",
    "download_url",
    "sha256",
    "homepage"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "tagline": {
      "type": "string",
      "maxLength": 140
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+.][0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "category": {
      "type": "string",
      "enum": [
        "account-automation",
        "quota-billing",
        "proxy-network",
        "workspace-ui",
        "automation-cdp",
        "security-audit"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "maxItems": 10,
      "uniqueItems": true
    },
    "official": {
      "type": "boolean"
    },
    "verified": {
      "type": "boolean"
    },
    "bundled": {
      "type": "boolean"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "windows",
          "macos",
          "linux"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "vault_storage",
          "profiles_read",
          "profiles_write",
          "browser_cdp",
          "proxy_http"
        ]
      }
    },
    "ui_slots": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "topbar",
          "profile_row",
          "profile_table_columns",
          "profile_row_actions",
          "toolbar",
          "toolbar_actions",
          "inline_panel"
        ]
      }
    },
    "min_nebula_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+.][0-9A-Za-z.-]+)?$"
    },
    "download_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{64})?$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "icon": {
      "type": "string"
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "changelog": {
      "type": "string"
    }
  }
}
